# Coverage settings for the live PostgreSQL certification steps of the Integration Tests job
# (.github/workflows/ci.yml, `--cov-config=config/coverage-live-integration.rc`).
#
# The root .coveragerc serves the UNIT floor and omits decision-service and the soil-service
# stores and routers because unit tests cannot reach them. Those are exactly the files the
# live steps exercise (for example soil-service plan_copy_store.py, or the vegetation anomaly
# store anomaly_store_pg.py), so this lane measures them and omits only test code.
[run]
omit =
    */tests/*
    */test_*.py
