{
  "schema_version": "1.0",
  "service": "weather-service",
  "source_service": "services/weather-service",
  "entrypoint": "services/weather-service/main.py",
  "base_url_env": "WEATHER_SERVICE_BASE_URL",
  "note": "Functional probes verify the service COMPUTES correctly (schema + value + determinism), not merely that it is alive. Only compute-only endpoints are declared here so a probe run needs no DB/Redis/external provider. Producing evidence and setting runtime_verified is a separate, deliberate step; this plan alone changes nothing in the runtime ledger.",
  "probes": [
    {
      "probe_id": "agro-et0-fao56",
      "method": "POST",
      "path": "/v1/weather/agro/et0",
      "dependency_class": "compute-only",
      "deterministic": true,
      "expected_status": 200,
      "request_body": {
        "t_max_c": 21.5,
        "t_min_c": 12.3,
        "t_mean_c": 16.9,
        "rh_mean_pct": 63.0,
        "wind_2m_ms": 2.078,
        "solar_rad_mj_m2": 22.07,
        "lat_deg": 50.8,
        "elevation_m": 100.0,
        "day_of_year": 187,
        "valid_time": "2026-07-06T12:00:00Z"
      },
      "response_assertions": [
        {
          "field": "et0_mm",
          "type": "number",
          "min": 2.0,
          "max": 6.0
        },
        {
          "field": "method",
          "equals": "fao56_penman_monteith"
        },
        {
          "field": "formula_version",
          "equals": "et0/fao56-pm/1.0.0"
        },
        {
          "field": "quality_status",
          "equals": "validated"
        }
      ]
    },
    {
      "probe_id": "agro-gdd-accumulation",
      "method": "POST",
      "path": "/v1/weather/agro/gdd",
      "dependency_class": "compute-only",
      "deterministic": true,
      "expected_status": 200,
      "request_body": {
        "daily_t_min": [
          10.0,
          12.0,
          11.0
        ],
        "daily_t_max": [
          25.0,
          28.0,
          26.0
        ],
        "base_c": 10.0,
        "upper_cutoff_c": 30.0,
        "method": "modified"
      },
      "response_assertions": [
        {
          "field": "accumulated_gdd",
          "type": "number",
          "equals": 26.0,
          "tolerance": 0.001
        },
        {
          "field": "quality_status",
          "equals": "validated"
        }
      ]
    }
  ],
  "identity_path": "/runtime-identity",
  "openapi_path": "/openapi.json"
}
