# Sahool local integration lab: pinned inputs. Sourced by up.sh, run.sh and down.sh.
#
# Images are pinned by manifest digest; a registry is only a transport. up.sh tries
# each registry in LAB_REGISTRIES and accepts the image only if its RepoDigests
# carry the pinned digest, so every registry yields the same bytes.
#
# Redis is the digest the CI "Integration Tests" job runs.
# PostgreSQL differs from CI on purpose: CI builds postgres@sha256:d4a8e1f8... plus
# postgresql-15-postgis-3 from apt (scripts/ci/build_postgis_test_image.sh), which
# needs deb.debian.org. When that host is unreachable the lab runs the upstream
# postgis/postgis:15-3.6 image below: same PostgreSQL 15.19, PostGIS 3.6.4, but a
# Debian 13 base instead of Debian 12. run.sh records both in the evidence.
LAB_PG_IMAGE_PATH="postgis/postgis"
LAB_PG_IMAGE_DIGEST="sha256:6f4773bfeae08b357ec781bbb9a83e67fcb7ab5e444b5e0e32e93f6f7798c222"
LAB_REDIS_IMAGE_PATH="library/redis"
LAB_REDIS_IMAGE_DIGEST="sha256:858f009f9709ce576febc734aa78b8f6d624b82571f9ddb6bda4377c833b3499"
LAB_REGISTRIES="public.ecr.aws/docker mirror.gcr.io docker.io"

# Same ports, database, user and password as the CI job, so the same test env applies.
LAB_PG_PORT=5433
LAB_REDIS_PORT=6380
LAB_PG_DB=sahool_test
LAB_PG_USER=sahool_test
LAB_PG_PASSWORD=test_password

# Every Docker object the lab creates carries this label; down.sh removes only these.
LAB_LABEL="sahool.lab=integration"
LAB_PG_CONTAINER=sahool-lab-pg
LAB_REDIS_CONTAINER=sahool-lab-redis

LAB_PYTHON="${LAB_PYTHON:-python3.12}"
LAB_DIR="${SAHOOL_LAB_DIR:-${TMPDIR:-/tmp}/sahool-lab}"
