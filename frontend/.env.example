# ══════════════════════════════════════════════════════════════
# SAHOOL v8.0 — .env.example
# انسخ هذا الملف إلى .env وعدّل القيم
# ══════════════════════════════════════════════════════════════

# ── وضع التطوير (mock data) ──────────────────────────────────
VITE_MOCK_MODE=false

# ── Kong Gateway (البوابة الموحدة) ───────────────────────────
VITE_API_URL=http://localhost:8000

# ── الخدمات المباشرة (للتطوير فقط) ─────────────────────────
VITE_INDICATORS_URL=http://localhost:8091
VITE_VEGETATION_URL=http://localhost:8090
VITE_WEATHER_URL=http://localhost:8092
VITE_SOIL_URL=http://localhost:8094
VITE_AUTH_URL=http://localhost:8120

# ── Claude API ───────────────────────────────────────────────
# ⚠ لا تضع مفتاح Claude في الواجهة: أيّ متغيّر VITE_* يُحزَم في حزمة JS العلنيّة
# (يُسرَّب لكلّ متصفّح). مفتاح Claude يبقى في الخلفية فقط (المستشار يعمل خادميّاً).

# ══════════════════════════════════════════════════════════════
# .env.production (للنشر الإنتاجي)
# ══════════════════════════════════════════════════════════════
# VITE_MOCK_MODE=false
# VITE_API_URL=https://api.your-domain.com
