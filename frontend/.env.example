# ══════════════════════════════════════════════════════════════
# SAHOOL — frontend/.env.example
# انسخ هذا الملف إلى .env.local وعدّل ما يلزم.
# ══════════════════════════════════════════════════════════════

# ── الوضع المرجعيّ (gateway): nginx/Kong على :80 ─────────────────
# الإنتاج المرجعيّ هو البوّابة على :80؛ تنادي الواجهةُ مساراتٍ نسبيّةً
# تُوجَّه عبر nginx (راجع nginx/nginx.fixed.conf). و`vite dev` يعمل بنفس
# المسارات عبر وكيل vite (vite.config.ts) الذي يُحاكي توجيه nginx.
# الافتراضيّ الضمنيّ في الكود = gateway، فلا حاجة لضبط أيّ شيء أدناه للإنتاج.
VITE_API_MODE=gateway

# قواعد العملاء — اتركها معطّلة لاستخدام افتراضات gateway النسبيّة:
#   kong  '' (المسارات تحمل /api/...)   ·  auth '' (تحمل /auth/...)
#   raster /api/raster · vegetation /api/vegetation · indicators /api/indicators
#   weather /api/weather · soil /api/soil   ·  ws /ws
# VITE_API_BASE_URL=
# VITE_AUTH_BASE_URL=
# VITE_RASTER_BASE_URL=/api/raster
# VITE_VEGETATION_BASE_URL=/api/vegetation
# VITE_INDICATORS_BASE_URL=/api/indicators
# VITE_WEATHER_BASE_URL=/api/weather
# VITE_SOIL_BASE_URL=/api/soil
# VITE_WS_BASE_URL=/ws

# ── أعلام الميزات (الافتراضيّ مُخفاة — لا خلفيّة جاهزة بعد) ─────────
# الطقس/التربة بلا توجيه خلفيّ عامل حاليّاً؛ مُخفاة لتفادي شاشات مكسورة.
# فعّلها (=true) حين تجهز خدمتاهما خلف البوّابة.
# VITE_ENABLE_WEATHER=false
# VITE_ENABLE_SOIL=false

# ══════════════════════════════════════════════════════════════
# # وضع التطوير المباشر (dev) — تشغيل الخدمات بلا بوّابة (منافذ localhost)
# # استخدمه فقط حين تشغّل الخدمات مباشرةً (لا nginx ولا وكيل vite).
# VITE_API_MODE=dev
# # القواعد عندئذٍ (افتراضات dev في الكود):
# #   kong http://localhost:8000 · auth http://localhost:8120
# #   raster http://localhost:8001 · vegetation http://localhost:8090
# #   indicators http://localhost:8091 · weather http://localhost:8092
# #   soil http://localhost:8094
# # ويمكن تجاوز أيّ منها صراحةً عبر VITE_*_BASE_URL أعلاه.
# ══════════════════════════════════════════════════════════════

# ── وضع التجريب (بيانات وهميّة) ──────────────────────────────────
VITE_MOCK_MODE=false

# ── Claude API ───────────────────────────────────────────────
# ⚠ لا تضع مفتاح Claude في الواجهة: أيّ متغيّر VITE_* يُحزَم في حزمة JS العلنيّة
# (يُسرَّب لكلّ متصفّح). مفتاح Claude يبقى في الخلفية فقط (المستشار يعمل خادميّاً).

# Optional professional satellite basemap (MapTiler)
VITE_MAPTILER_KEY=
