# Multi-stage build for ARM64 edge devices
FROM python:3.12-slim-bookworm AS builder

ARG EDGE_REQUIREMENTS=requirements.txt
ARG TARGETARCH
# The pinned PyPI GPU wheel supports amd64 only; ARM64 keeps the CPU profile.
# TARGETARCH is supplied by BuildKit; dpkg also supports legacy native builds.
RUN if [ "${EDGE_REQUIREMENTS##*/}" = "requirements-gpu.txt" ]; then \
        edge_arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
        if [ "${edge_arch}" != "amd64" ]; then \
            printf '%s\n' "Unsupported edge GPU build architecture: ${edge_arch}. onnxruntime-gpu==1.26.0 requires amd64; use requirements.txt for ARM64 CPU builds." >&2; \
            exit 1; \
        fi; \
    fi

WORKDIR /app
ARG DEBIAN_MIRROR=
RUN if [ -n "${DEBIAN_MIRROR}" ]; then \
        sed -i \
            -e "s|http://deb.debian.org/debian-security|${DEBIAN_MIRROR%/}/debian-security|g" \
            -e "s|http://deb.debian.org/debian|${DEBIAN_MIRROR%/}/debian|g" \
            /etc/apt/sources.list.d/debian.sources; \
    fi \
    && apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY services/edge-inference/requirements*.txt ./
# ── مرآة pip صينيّة (PyPI محجوب/بطيء) — قابلة للتجاوز بـ--build-arg ──
# Alibaba override: --build-arg PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ARG PIP_INDEX_URL=https://pypi.org/simple
ARG PIP_TRUSTED_HOST=
ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST}
# نُثبّت إلى /opt/pylocal (لا /root/.local الافتراضيّ): /root وضعه 0700 فلا يقرأه
# المستخدم غير الجذر (sahool) في طور التشغيل ⇒ تكسر الاستيرادات. /opt قابل للاجتياز.
ENV PYTHONUSERBASE=/opt/pylocal
RUN pip install --no-cache-dir --timeout 300 --retries 10 --user -r "${EDGE_REQUIREMENTS}"

# Runtime stage
FROM python:3.12-slim-bookworm

WORKDIR /app

# Install runtime dependencies
ARG DEBIAN_MIRROR=
RUN if [ -n "${DEBIAN_MIRROR}" ]; then \
        sed -i \
            -e "s|http://deb.debian.org/debian-security|${DEBIAN_MIRROR%/}/debian-security|g" \
            -e "s|http://deb.debian.org/debian|${DEBIAN_MIRROR%/}/debian|g" \
            /etc/apt/sources.list.d/debian.sources; \
    fi \
    && apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Copy Python packages from builder (/opt/pylocal — قابل للقراءة لـsahool، خلاف /root)
COPY --from=builder /opt/pylocal /opt/pylocal
ENV PATH=/opt/pylocal/bin:$PATH
# نُضمّن مسار حزم --user في PYTHONPATH كي تُكتشَف الحزم المثبَّتة بـ--user مع /app.
ENV PYTHONPATH=/opt/pylocal/lib/python3.12/site-packages:/app

# Make the GPU wheel's CUDA and cuDNN libraries available to the Linux dynamic loader.
RUN if [ -d /opt/pylocal/lib/python3.12/site-packages/nvidia ]; then \
        printf '%s\n' /opt/pylocal/lib/python3.12/site-packages/nvidia/*/lib > /etc/ld.so.conf.d/edge-cuda.conf && ldconfig; \
    fi

# الأوّليّات الأمنيّة المشتركة (stdlib-only) — تعريفٌ واحدٌ لمقارِن توكن الخدمة ثابتِ
# الزمن بدل نسخةٍ محلّيّة تنحرف. بلا هذا السطر يفشل استيرادُ main.py عند الإقلاع،
# وذاك المقصود: عطلُ توصيلٍ يُرى لا يُبتلَع (GUARDRAIL-FLAGS-FILE-NOT-IN-ANY-IMAGE-01).
COPY shared/ /app/shared/

# Copy application (الخدمة فقط، لا كامل المشروع — context هو الجذر)
COPY services/edge-inference/ /app/

# Empty named volumes inherit these owners. The offline queue writes as sahool.
RUN useradd -m sahool && install -d -o sahool -g sahool /models /data/sync_queue

ENV PYTHONUNBUFFERED=1
ENV EDGE_DEVICE=rpi5
ENV OFFLINE_MODE=false
ENV SYNC_INTERVAL=3600

EXPOSE 8100

# الصورة الوحيدة التي كانت بلا HEALTHCHECK (للتشغيل المستقلّ؛ compose يوفّر مثله).
# python بدل curl (غير مثبَّت) — /healthz موجود في الخدمة.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8100/healthz').status==200 else 1)" || exit 1

USER sahool
RUN test -w /data/sync_queue && test -w /models
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8100"]
