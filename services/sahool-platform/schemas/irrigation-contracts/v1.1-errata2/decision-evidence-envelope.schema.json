{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sahool.dev/schemas/irrigation-contracts/v1.1-errata2/decision-evidence-envelope.schema.json",
  "title": "DecisionEvidenceEnvelope",
  "description": "الحد الفاصل بين الذكاء الزراعي وخدمة القرار — v1.1-errata2. execution_allowed وrequires_human_review يأتيان من Policy/Safety Gate حصريًا، وتثبيتهما البنيوي هنا يعكس مرحلة ما قبل الاعتماد؛ الموافقة البشرية تُثبَت في مرحلة Execution لا في هذا المغلف. decision_domains مغلق على irrigation (الشرط 6) وfertigation_candidate_id ثابت null.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_revision",
    "decision_id",
    "correlation_id",
    "state_snapshot_id",
    "prediction_id",
    "model_version",
    "policy_version",
    "input_digest",
    "candidate_digest",
    "hydraulic_feasibility_digest",
    "execution_allowed",
    "requires_human_review",
    "decision_domains",
    "fertigation_candidate_id"
  ],
  "properties": {
    "schema": {
      "const": "sahool.decision-evidence-envelope/v1.1"
    },
    "contract_revision": {
      "const": "v1.1-errata2"
    },
    "decision_id": {
      "$ref": "#/$defs/Ulid"
    },
    "correlation_id": {
      "$ref": "#/$defs/Ulid"
    },
    "state_snapshot_id": {
      "$ref": "#/$defs/Ulid"
    },
    "prediction_id": {
      "$ref": "#/$defs/Ulid"
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "input_digest": {
      "$ref": "#/$defs/Sha256Hex"
    },
    "candidate_digest": {
      "$ref": "#/$defs/Sha256Hex"
    },
    "hydraulic_feasibility_digest": {
      "$ref": "#/$defs/Sha256Hex"
    },
    "execution_allowed": {
      "const": false
    },
    "requires_human_review": {
      "const": true
    },
    "decision_domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "const": "irrigation"
      }
    },
    "fertigation_candidate_id": {
      "type": "null",
      "description": "يبقى null حتى اكتمال FertigationState (C1–C5 + C6-LIVE-DECISION + قرار مالك) — الشرط 6."
    }
  },
  "$defs": {
    "Ulid": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "ULID بترميز Crockford Base32. المحرف الأول مقيَّد بـ[0-7]: خانة الزمن العليا في ULID ذي 128 بت لا تتجاوز 7 — النمط الأوسع كان يقبل معرّفات مستحيلة (رقعة مراجعة ما قبل الإيداع)."
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
