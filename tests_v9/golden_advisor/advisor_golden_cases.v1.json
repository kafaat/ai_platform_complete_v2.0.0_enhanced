{
  "schema": "sahool.advisor_golden_eval",
  "schema_version": 1,
  "cases_revision": "2026-11-22.1",
  "runner": "tests_v9/golden_advisor/test_advisor_golden_eval.py",
  "scope": "Structural checks of the advisor's evidence behaviour, run offline against the real service functions with canned inputs. No network, no model call, no database. A case checks shape and codes, never agronomic correctness.",
  "known_gap_policy": "A case whose expected behaviour is not on main carries known_gap and runs as a strict expected failure (pytest xfail strict=True, raises=AssertionError). When the fix lands the case passes, the strict xfail turns the run red, and the known_gap entry is removed in the same change. names_code_containing matches a fragment of a code, not a fixed code name: if the fix names its code differently, the case stays an expected failure until the fragment is updated, so check the gap cases when landing a fix.",
  "agronomist_review_policy": "Every case has an agronomist_review block with empty slots. Only a named agronomist fills them, with reviewer and reviewed_on, and sets status to signed_off. Until then reference_answer_ar stays null and forbidden_product_terms stays empty; the runner refuses a filled slot without a sign-off. The no_dose_or_product_name check reads forbidden_product_terms, so product names are not checked until an agronomist supplies them.",
  "cases": [
    {
      "id": "missing_evidence.no_sources",
      "category": "missing_evidence",
      "layer": "runtime",
      "description": "No field, retrieval answers with no excerpt, no field context: the advisor must abstain and ask for review.",
      "input": {
        "request": {"question": "golden-eval: what is the state?"},
        "rag": {"status": 200, "annotations": "none"},
        "field_state": "none",
        "audit": {"stub_status": "recorded"}
      },
      "expect": {
        "http_status": 200,
        "abstains": true,
        "requires_human_review": true,
        "decision": "advisory_only",
        "evidence_missing_include": ["no_grounding_evidence"],
        "limitations_include": ["generation_disabled_evidence_only", "low_confidence"],
        "generation_surfaced": false,
        "no_dose_or_product_name": true
      },
      "known_gap": null,
      "agronomist_review": {"status": "awaiting_sign_off", "reference_answer_ar": null, "forbidden_product_terms": [], "reviewer": null, "reviewed_on": null}
    },
    {
