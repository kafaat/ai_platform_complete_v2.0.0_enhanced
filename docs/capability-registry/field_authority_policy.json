{
  "schema": "sahool.capability-field-authority/v1",
  "schema_version": "1.0.0",
  "purpose": "Assign authority per capability field without creating a third capability value source of truth.",
  "sources": {
    "canonical_capability_definition": "docs/capability-registry/capability_index.yaml + docs/capability-registry/domains/*.yaml",
    "legacy_registry_projection": "capabilities/registry/capabilities.json",
    "repository_traceability_projection": "scripts/ci/capability_linker.py",
    "repository_runtime_instrumentation": "scripts/ci/capability_runtime_evidence.py",
    "runtime_verification": "scripts/ci/runtime_verification_apply.py + runtime-verification/apply-ledger/*.json",
    "certification": "explicit certification decision; never repository instrumentation"
  },
  "field_authority": {
    "id": {
      "authority": "canonical_capability_definition",
      "legacy_role": "compatibility_projection"
    },
    "domain": {
      "authority": "canonical_capability_definition",
      "legacy_role": "compatibility_projection"
    },
    "dependencies": {
      "authority": "canonical_capability_definition",
      "legacy_role": "compatibility_projection"
    },
    "maturity": {
      "authority": "canonical_capability_definition",
      "enum": [
        0,
        1,
        2,
        3,
        4,
        5
      ],
      "legacy_role": "compatibility_projection"
    },
    "evidence_level": {
      "authority": "canonical_capability_definition",
      "enum": [
        0,
        1,
        2,
        3,
        4,
        5
      ],
      "legacy_role": "compatibility_projection"
    },
    "owner": {
      "authority": "canonical_capability_definition",
      "legacy_role": "compatibility_projection"
    },
    "services": {
      "authority": "repository_traceability_projection"
    },
    "apis": {
      "authority": "repository_traceability_projection",
      "reconciliation": "excluded_projection_owned_by_traceability_engine"
    },
    "tests": {
      "authority": "repository_traceability_projection",
      "reconciliation": "excluded_projection_owned_by_traceability_engine"
    },
    "ui_consumers": {
      "authority": "repository_traceability_projection"
    },
    "mobile_consumers": {
      "authority": "repository_traceability_projection"
    },
    "runtime.metrics": {
      "authority": "repository_runtime_instrumentation"
    },
    "runtime.traces": {
      "authority": "repository_runtime_instrumentation"
    },
    "runtime.audit_events": {
      "authority": "repository_runtime_instrumentation"
    },
    "runtime.repository_receipts": {
      "authority": "repository_runtime_instrumentation"
    },
    "runtime.verification_receipts": {
      "authority": "runtime_verification",
      "append_only": true,
      "receipt_type": "attested-runtime-verification"
    },
    "runtime_verified": {
      "authority": "runtime_verification",
      "promotion": "false_to_true_only_by_governed_apply"
    },
    "production_certified": {
      "authority": "certification",
      "automatic_promotion": false
    },
    "status": {
      "authority": "legacy_registry_projection",
      "reconciliation": "excluded_until_structured_normalization",
      "semantic": "legacy_compatibility_status",
      "disposition": "temporary_legacy_authority_until_structured_normalization"
    },
    "title": {
      "authority": "legacy_registry_projection",
      "semantic": "compatibility_localized_title",
      "canonical_reference": "canonical_capability_definition",
      "disposition": "temporary_compatibility_shape_until_structured_normalization",
      "reconciliation": "excluded_until_structured_normalization"
    },
    "runtime": {
      "reconciliation": "excluded_composite_owned_by_runtime_instrumentation_and_verification",
      "authority": "composite_runtime_authorities",
      "disposition": "explicit_composite_container",
      "components": [
        "repository_runtime_instrumentation",
        "runtime_verification"
      ]
    },
    "evidence": {
      "reconciliation": "excluded_until_structured_normalization",
      "authority": "composite_evidence_authorities",
      "disposition": "explicit_composite_container",
      "components": [
        "canonical_definition_evidence",
        "repository_traceability_evidence",
        "runtime_verification_evidence",
        "certification_evidence"
      ]
    },
    "rationale": {
      "authority": "repository_traceability_projection",
      "semantic": "repository_traceability_rationale",
      "reconciliation": "excluded_projection_owned_by_traceability_engine"
    },
    "lifecycle": {
      "authority": "canonical_capability_definition",
      "legacy_role": "compatibility_projection"
    },
    "confidence": {
      "authority": "repository_traceability_projection",
      "semantic": "repository_traceability_confidence",
      "canonical_copy_role": "non_authoritative_metadata",
      "reconciliation": "excluded_projection_owned_by_traceability_engine"
    },
    "competitive": {
      "authority": "legacy_registry_projection",
      "semantic": "compatibility_competitive_assessment",
      "canonical_role": "none",
      "disposition": "keep_outside_canonical_capability_definition",
      "reconciliation": "excluded_compatibility_assessment_outside_canonical_definition"
    }
  },
  "reconciliation": {
    "compare_raw": [
      "id",
      "domain",
      "dependencies",
      "maturity",
      "evidence_level",
      "owner",
      "lifecycle"
    ],
    "exclude_raw": [
      "title",
      "apis",
      "tests",
      "runtime",
      "evidence",
      "rationale",
      "status",
      "confidence",
      "competitive"
    ],
    "no_third_value_registry": true
  },
  "promotion_preconditions": {
    "l5_alone_sufficient": false,
    "execution_outcome_schema": "sahool.execution-outcome/v1",
    "runtime_verified": [
      "governed_apply_receipt",
      "execution_outcome",
      "subject_sha_binding"
    ],
    "production_certified": [
      "evidence_level_5_necessary_not_sufficient",
      "execution_outcome",
      "subject_sha_binding",
      "explicit_certification_decision"
    ]
  }
}
