+// الشاهد: لوحة الاقتصاد تمرّر الحقلَ المختار إلى الاستعلام. الخادم لا يحسب الحجم/القيمة
+// (m³ · العملة) إلّا مع field_id واحد، فبدونه تبقى الأرقام «غير متاحة» مهما أدخل المستخدم
+// المساحة والتكلفة. يُقاس بالاستدعاء الفعليّ للخطّاف عند التصيير، لا بنصّ المصدر.
+import { render } from '@testing-library/react';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+const economicsCalls: unknown[][] = [];
+const query = { data: undefined, isLoading: false, isError: false, error: null, refetch: vi.fn() };
+const mutation = { mutate: vi.fn(), mutateAsync: vi.fn(), isPending: false, isError: false, data: undefined, error: null, reset: vi.fn() };
+
+vi.mock('../../hooks/useDecisionDeep', () => ({
+  useDecisionEconomics: (...args: unknown[]) => { economicsCalls.push(args); return query; },
+  useDecisionExplainDeep: () => query,
+  useDecisionForLocation: () => query,
+  useUnifiedDecision: () => mutation,
+  useExecuteDispatch: () => mutation,
+  useRecordDecision: () => mutation,
+  useResolveDecisionPolicies: () => mutation,
+}));
+
+let selectedFieldId: string | null = 'field-7';
+vi.mock('../../hooks/useSelectedField', () => ({
+  useSelectedField: () => ({
+    options: selectedFieldId ? [{ id: selectedFieldId, label: 'حقل' }] : [],
+    fieldId: selectedFieldId, setFieldId: vi.fn(), isLoading: false, isError: false,
+  }),
+}));
+
+import DecisionDeepPanel from './DecisionDeepPanel';
+
+describe('DecisionDeepPanel — economics query carries the selected field', () => {
+  beforeEach(() => { economicsCalls.length = 0; });
+
+  it('passes the active field id to useDecisionEconomics', () => {
+    selectedFieldId = 'field-7';
+    render(<DecisionDeepPanel />);
+    expect(economicsCalls.length).toBeGreaterThan(0);
+    const opts = economicsCalls[economicsCalls.length - 1][0] as { fieldId?: string };
+    expect(opts.fieldId).toBe('field-7');
+  });
+
+  it('sends no field id when none is selected (portfolio view stays honest)', () => {
+    selectedFieldId = null;
+    render(<DecisionDeepPanel />);
+    const opts = economicsCalls[economicsCalls.length - 1][0] as { fieldId?: string };
+    expect(opts.fieldId).toBeUndefined();
+  });
+});
