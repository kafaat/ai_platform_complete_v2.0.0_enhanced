+// Actuator v2: verify the exact signed body before parsing or operating the relay.
+// Provision cmdconfig/key as the 64 hex characters of device_key(root, tenant, device).
+// This is a per-device derived key, NOT the server root secret.
+static bool loadDeviceKey(uint8_t key[32]) {
+  Preferences config;
+  if (!config.begin("cmdconfig", true)) return false;
+  String hex = config.getString("key", "");
+  config.end();
+  if (hex.length() != 64 || String(TENANT_ID) == "default") return false;
+  for (int i = 0; i < 32; ++i) {
+    int value = 0;
+    for (int j = 0; j < 2; ++j) {
+      char c = hex[i * 2 + j];
+      int nibble = c >= '0' && c <= '9' ? c - '0' : (c >= 'a' && c <= 'f' ? c - 'a' + 10 : -1);
+      if (nibble < 0) return false;
+      value = value * 16 + nibble;
+    }
+    key[i] = static_cast<uint8_t>(value);
+  }
+  return true;
+}
