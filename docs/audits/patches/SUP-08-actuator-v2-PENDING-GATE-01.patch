+
+static bool constantEqual(const String& left, const char* right) {
+  if (!right || left.length() != 64 || strlen(right) != 64) return false;
+  uint8_t difference = 0;
+  for (int i = 0; i < 64; ++i) difference |= left[i] ^ right[i];
+  return difference == 0;
+}
+
+static void publishReceipt(const uint8_t key[32], const char* commandId, const char* state) {
+  StaticJsonDocument<512> receipt;
+  receipt["v"] = 2;
+  receipt["tenant_id"] = TENANT_ID;
+  receipt["device_id"] = DEVICE_ID;
+  receipt["command_id"] = commandId;
+  receipt["state"] = state;
+  // This is the relay output, not a verified valve position or delivered water.
+  receipt["relay_output"] = digitalRead(RELAY_PIN) ? "ON" : "OFF";
+  receipt["observed_at"] = static_cast<int64_t>(time(nullptr));
+  String body;
+  serializeJson(receipt, body);
+  StaticJsonDocument<1024> envelope;
+  envelope["body"] = body;
+  envelope["sig"] = signWire(key, "sahool-receipt-v2\n", body);
+  String wire;
+  serializeJson(envelope, wire);
+  String topic = String("sahool/actuator/") + DEVICE_ID + "/receipt";
+  mqttClient.publish(topic.c_str(), wire.c_str(), false);
+}
+
+void mqttCallback(char* topic, byte* bytes, unsigned int length) {
+  if (String(topic) != String("sahool/actuator/") + DEVICE_ID + "/command" || length > 2048) return;
+  uint8_t key[32];
+  if (!loadDeviceKey(key)) return;
+  StaticJsonDocument<2560> envelope;
+  if (deserializeJson(envelope, bytes, length)) return;
+  const char* rawBody = envelope["body"];
+  const char* signature = envelope["sig"];
+  if (!rawBody || strlen(rawBody) > 1536) return;
+  String body(rawBody);
+  if (!constantEqual(signWire(key, "sahool-command-v2\n", body), signature)) return;
+  StaticJsonDocument<2048> command;
+  if (deserializeJson(command, body)) return;
+  const char* id = command["command_id"];
+  const char* cmd = command["cmd"];
+  if (!id || !cmd || strlen(id) == 0 || strlen(id) > 128 || command["v"] != 2) return;
+  if (command["tenant_id"].as<String>() != TENANT_ID || command["device_id"].as<String>() != DEVICE_ID) return;
+  bool opens = strcmp(cmd, "OPEN") == 0 || strcmp(cmd, "ON") == 0;
+  if (!opens && strcmp(cmd, "CLOSE") != 0 && strcmp(cmd, "OFF") != 0) return;
+  int64_t now = static_cast<int64_t>(time(nullptr));
+  int64_t issued = command["issued_at"] | static_cast<int64_t>(0);
+  int64_t expires = command["expires_at"] | static_cast<int64_t>(0);
+  if (now < 1700000000 || issued > now + 5 || expires <= now || expires <= issued || expires - issued > 60) return;
+  // NVS keys are short hashes; the complete ID is retained to reject a collision.
+  String slot = signWire(key, "sahool-ledger-key-v2\n", String(id)).substring(0, 15);
+  Preferences ledger;
+  if (!ledger.begin("cmdledger", false)) return;
+  String prior = ledger.getString(slot.c_str(), "");
+  if (prior.length()) {
+    ledger.end();
+    if (prior == String(id) + "|done") publishReceipt(key, id, "duplicate");
+    else publishReceipt(key, id, "uncertain_or_conflicting");
+    return;  // Never repeat relay work, including after a reset or lost receipt.
+  }
+  String pending = String(id) + "|pending";
+  if (ledger.putString(slot.c_str(), pending) != pending.length()) { ledger.end(); return; }
+  // Persist intent BEFORE the physical effect. A crash leaves uncertain work for
+  // operator reconciliation; it must never trigger an automatic replay.
+  setRelay(opens);
+  String done = String(id) + "|done";
+  bool persisted = ledger.putString(slot.c_str(), done) == done.length();
+  ledger.end();
+  publishReceipt(key, id, persisted ? "relay_written" : "uncertain");
+  // Entries are never evicted silently. Full NVS fails closed; maintenance needs
+  // an independently fenced command epoch and an approved reconciliation plan.
 }
 
