+"""Bound actuator v2 wire envelope. Requires coordinated device cutover."""
+from __future__ import annotations
+import hashlib
+import hmac
+import json
+import re
+import time
+
+
+def device_key(root_secret: str, tenant_id: str, device_id: str) -> bytes:
+    if len(root_secret) < 32:
+        raise ValueError("device signing root must contain at least 32 characters")
+    return hmac.digest(root_secret.encode(), f"sahool-device-v2\n{tenant_id}\n{device_id}".encode(), "sha256")
+
+
+def encode_command(root_secret: str, tenant_id: str, device_id: str,
+                   command_id: str, command: str, payload: dict, *, now: int | None = None) -> str:
+    for value in (tenant_id, device_id, command_id):
+        if not isinstance(value, str) or not re.fullmatch(r"[A-Za-z0-9_-]{1,128}", value):
+            raise ValueError("a bound identity is required")
+    if command not in {"OPEN", "CLOSE", "ON", "OFF"}:
+        raise ValueError("unsupported relay command")
+    issued = int(time.time()) if now is None else now
+    body = json.dumps({"v": 2, "tenant_id": tenant_id, "device_id": device_id,
+                       "command_id": command_id, "cmd": command, "payload": payload,
+                       "issued_at": issued, "expires_at": issued + 60},
+                      sort_keys=True, ensure_ascii=True, separators=(",", ":"), allow_nan=False)
+    if len(body.encode()) > 1536:
+        raise ValueError("command exceeds device wire budget")
+    key = device_key(root_secret, tenant_id, device_id)
+    sig = hmac.new(key, b"sahool-command-v2\n" + body.encode(), hashlib.sha256).hexdigest()
+    return json.dumps({"body": body, "sig": sig}, separators=(",", ":"))
