{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sahool.local/schemas/evidence-manifest-v1.json",
  "title": "SAHOOL canonical evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "closure",
    "tested_identity",
    "source_identity",
    "release_binding",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "sahool.evidence-manifest/v1"
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "transport_exclusions"
      ],
      "properties": {
        "mode": {
          "const": "exact"
        },
        "transport_exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "tested_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_sha",
        "tree_sha"
      ],
      "properties": {
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "release_binding": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "pending_final_rerun",
            "exact_commit",
            "exact_tree",
            "tested_merge_to_release"
          ]
        },
        "accepted_commit_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "accepted_tree_sha": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "adjudicated_on": "2026-08-11",
  "schema": "sahool.evidence-manifest-schema/v1",
  "version": 1
}
