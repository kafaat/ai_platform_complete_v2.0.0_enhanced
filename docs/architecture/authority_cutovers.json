      "cutover_rule": "explicit production approval + role certification + DB revoke/grant proof; no dual-authoritative recommendation_outcomes writes"
    },
    "field_management": {
      "declared_state": "OWNER_DECLARED",
      "cutover_capability": "NOT_YET_CUTOVER_CAPABLE",
      "authority_state": "NOT_YET_AUTHORITATIVE",
