{
  "schema": "sahool.authority-cutovers/v1",
  "version": 1,
  "sequence": [
    "decision",
    "field_management",
    "knowledge_graph"
  ],
  "invariant": "expand_reconcile_cutover_revoke",
  "authorities": {
    "decision": {
      "declared_state": "INTERIM",
      "cutover_capability": "CUTOVER_CAPABLE",
      "authority_state": "NOT_YET_AUTHORITATIVE",
