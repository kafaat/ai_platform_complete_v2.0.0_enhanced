# SAHOOL v9.0 — .env.example
# ⚠️ أنشئ .env بنسخ هذا الملف: cp .env.example .env
# ⚠️ عدّل كل القيم قبل الإنتاج

# Database
# ملاحظة: compose يستخدم DB_PASSWORD (وuser=sahool_user) — وُحّد الاسمان هنا.
POSTGRES_PASSWORD=sahool_db_pass_change_me
DB_PASSWORD=sahool_db_pass_change_me
# ── نموذج الدورين (أمان RLS) ──────────────────────────────────────
# المالك sahool_user مُمتاز (superuser) ويُجري الهجرات فقط؛ superuser يتجاوز RLS
# حتى مع FORCE. لذلك التطبيق يتّصل بالدور المقيّد sahool_app (NOBYPASSRLS) عبر
# DATABASE_URL أدناه ليبقى عزل المستأجرين فعّالاً. يُنشئ sahool_app سكربت
# migrations/bootstrap_postgres.sh مستخدماً APP_DB_PASSWORD التالي.
APP_DB_PASSWORD=sahool_app_pass_change_me

# Auth (REQUIRED: أنشئ بـ: openssl rand -hex 32)
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_SECRET_BEFORE_PRODUCTION_USE__MIN32

# MinIO
MINIO_ROOT_USER=sahool-admin
MINIO_ROOT_PASSWORD=minio_pass_change_me

# Grafana
GRAFANA_PASSWORD=grafana_pass_change_me

# Sentinel Hub (https://www.sentinel-hub.com/develop/api/)
SH_CLIENT_ID=
SH_CLIENT_SECRET=
SH_INSTANCE_ID=

# Copernicus Data Space Ecosystem (CDSE) — مجّاني، Sentinel-1/2 عبر Sentinel Hub APIs
# سجّل في https://dataspace.copernicus.eu ثمّ أنشئ OAuth client
# ⚠️ لا تضع القيم هنا — ضعها في .env المحلّي (غير المرفوع)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
SH_BASE_URL=https://sh.dataspace.copernicus.eu
SH_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
# CDSE هو المزوّد الافتراضيّ للصور (أقوى)؛ عند غياب الاعتمادات أو CDSE_ENABLED=false
# يسقط النظام تلقائيّاً إلى Element84 Earth Search (المسار القائم). لتعطيله: CDSE_ENABLED=false
CDSE_ENABLED=true

# ── الاستشعار عن بُعد الكنسيّ (RS cutover) ─────────────────────────
# نمط استمرار أصول raster: required = يفشل المعالجة إن لم تُحفَظ بشكل دائم (fail-closed،
# إنتاج)؛ best_effort = يُعلّم النتيجة processed_unpublished (تطوير، غير قابلة للاستهلاك).
RASTER_PERSISTENCE_MODE=required
# مُعرّف سياسة جودة الملاحظة الكنسيّة (NDVI حقيقيّ فقط) — يُستهلَك في indicators-service.
RS_OBSERVATION_POLICY_ID=NDVI_CURRENT_REAL_ONLY_V1
# جسر التحقّق الأرضيّ (RS-7): خدمة المهام لإنشاء مهمّة كشف ميدانيّ + توكن ردّ النتيجة.
# فارغة افتراضيّاً ⇒ الجسر معطَّل (fail-closed): طلب التحقّق يُرفَض بوضوح لا يُنفَّذ صامتاً.
TASK_SERVICE_URL=
TASK_SERVICE_CALLBACK_TOKEN=
# مهلة BFF مساحة عمل الاستشعار (RS-9) لتجميع القراءات من الخدمات الأعلى (ثوانٍ).
WORKSPACE_BFF_TIMEOUT_S=6

# Telegram Bot (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# Claude AI (https://console.anthropic.com)
VITE_CLAUDE_API_KEY=

# Supervisor Agent
SAHOOL_AGENT_TOKEN=

# Edge
EDGE_DEVICE=rpi5
OFFLINE_MODE=false
EDGE_SYNC_TOKEN=

# ── SAM2 حدود الحقل (تنظيف مضلّع القناع) — تُضبَط على sahool-sam2-inference ──
# تبسيط الحدّ بالأمتار (يُزيل «درج البكسل» ورؤوسه شبه المكرّرة). ارفعه لحدود أنعم.
SAM2_POLYGON_SIMPLIFY_TOLERANCE_M=3
# مسافة دمج الرؤوس المتتالية شبه المكرّرة بالأمتار (تنظيف إضافيّ بعد التبسيط).
SAM2_POLYGON_DEDUP_TOLERANCE_M=0.5

# ── الواجهة: خريطة أساس Mapbox (اختياريّة) — تظهر فقط عند ضبط المفتاح ──
# بدونها يبقى Esri World Imagery الافتراضيّ (بلا مفتاح) فلا تنكسر الخريطة.
VITE_MAPBOX_TOKEN=
VITE_MAPTILER_KEY=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=


# ── Python package mirror for connected CI lock compilation ───────────────
# Default: Alibaba Cloud PyPI mirror. Override with a private/internal mirror in CI.
PYPI_MIRROR_URL=https://pypi.org/simple
# Optional Alibaba mirror override:
# PYPI_MIRROR_URL=https://mirrors.aliyun.com/pypi/simple/
# PIP_TRUSTED_HOST=mirrors.aliyun.com
PIP_TRUSTED_HOST=

# Models
MODELS_BASE_URL=https://github.com/sahool-ai/models/releases/download/v9.0

# التطبيق يتّصل بالدور المقيّد sahool_app (لا sahool_user) ليبقى RLS فعّالاً.
# للهجرات/الإدارة فقط استعمل: postgresql://sahool_user:${DB_PASSWORD}@sahool-postgres:5432/sahool
DATABASE_URL=postgresql://sahool_app:${APP_DB_PASSWORD}@sahool-postgres:5432/sahool
# مسار المهامّ الخلفيّة (مرسِل event_outbox/مجدوِل الطقس) يقرأ عابراً للمستأجرين بالتصميم
# ⇒ دور sahool_jobs (BYPASSRLS، يُنشئه apply_in_compose.sh بكلمة JOBS_DB_PASSWORD).
# مطلوب في الإنتاج (RLS مُفعَّلة)، وإلّا يفشل المرسِل تحت RLS على event_outbox.
JOBS_DB_PASSWORD=sahool_jobs_pass_change_me
JOBS_DATABASE_URL=postgresql://sahool_jobs:${JOBS_DB_PASSWORD}@sahool-postgres:5432/sahool
# IRR-F01: فترة استطلاع عامل دورة حياة الحجز (يُنهي الحجوزات المنقضية عبر تحويل v205 المحكوم).
# الخدمة opt-in تحت بروفايل compose `irrigation-runtime` وتستعمل JOBS_DATABASE_URL (دور المهامّ العابر).
IRRIGATION_RESERVATION_LIFECYCLE_POLL_SECONDS=15
# مدخل الإدخال الخارجيّ scout-ingest-service (SCOUT-INGEST-01): دور sahool_ingest المقيَّد
# (SELECT+INSERT فقط، NOBYPASSRLS، يُنشئه bootstrap بكلمة INGEST_DB_PASSWORD). خلف راية off افتراضاً.
INGEST_DB_PASSWORD=sahool_ingest_pass_change_me
INGEST_DATABASE_URL=postgresql://sahool_ingest:${INGEST_DB_PASSWORD}@sahool-postgres:5432/sahool

# Per-service object-storage identities. Provision these users with prefix-scoped
# policies; never copy MINIO_ROOT_USER/MINIO_ROOT_PASSWORD into workloads.
SCOUT_INGEST_S3_ACCESS_KEY=scout-ingest-change-me
SCOUT_INGEST_S3_SECRET_KEY=replace-with-random-secret
RASTER_S3_ACCESS_KEY=raster-service-change-me
RASTER_S3_SECRET_KEY=replace-with-random-secret

# Internal field catalog caller boundary. Production refuses an empty allowlist.
FIELD_SERVICE_ALLOWED_CALLERS=vegetation-analysis-service
FIELD_SERVICE_TENANT_ASSERTION_KEY=replace-with-at-least-32-random-bytes
FIELD_SERVICE_TENANT_ASSERTION_KEY_ID=current
# During rotation only: retain the previous key briefly, then remove it.
FIELD_SERVICE_TENANT_ASSERTION_PREVIOUS_KEY=
FIELD_SERVICE_TENANT_ASSERTION_PREVIOUS_KEY_ID=previous
SCOUT_INGEST_ENABLED=0
# B1.3: توكن قناة قراءة النموذج المملوك (مخصّص، ليس SAHOOL_AGENT_TOKEN) + عامل الإسقاط (off افتراضاً).
SCOUT_INGEST_READ_TOKEN=
SCOUT_INGEST_PROJECTION_ENABLED=0
SCOUT_INGEST_PROJECTION_POLL_SECONDS=5
# SEASON-RECORD-ENTRY-01: واجهة إدخال سجلّ الموسم (النقاط الستّ على scout-ingest، off افتراضاً).
SEASON_ENTRY_ENABLED=0
# توكن خدمة مخصّص لقناة إدخال المواسم (سرّ يُحقَن إنتاجاً؛ فارغ هنا). SEASON_EDGE_HMAC_KEY فئة B (لا في compose).
SEASON_ENTRY_SERVICE_TOKEN=
# GAP-FIELD-FORMS-01 (Slice 2): واجهات النماذج الميدانيّة /internal/field-forms/* على scout-ingest (off ⇒ 404)
# + توكن قناة BFF مخصّص يحقنه proxy المنصّة (§8.6، فارغ ⇒ 503 صادق). SCOUT_INGEST_URL: عنوان الخدمة الذي تعرفه المنصّة.
FIELD_FORMS_ENABLED=0
FIELD_FORMS_SERVICE_TOKEN=
SCOUT_INGEST_URL=http://sahool-scout-ingest:8000
# مجلّد تدهور مرفقات الدفتر (تطوير، file://)؛ الإنتاج يستعمل MinIO المشترك (S3_*).
LOGBOOK_LOCAL_DIR=/tmp/sahool-logbooks
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
# اسم المستهلك الدائم (durable) لعامل الإسقاط الكنسيّ والتعلّم
# (sahool-canonical-execution-learning-worker). ثابتٌ عمداً: تغييره يُنشئ مستهلكاً
# جديداً يبدأ من سياسة التسليم الافتراضيّة بدل استئناف موضع الأوّل — أي إعادة
# معالجة أو تخطّي. غيّره فقط عند إعادة تسمية مقصودة للمستهلك.
CANONICAL_LEARNING_DURABLE=canonical-execution-learning-v1
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
SENTINEL_HUB_API_KEY=
WEATHER_API_KEY=
# MinIO/S3 aliases consumed by backend clients. Keep these equal to the running
# MinIO root credentials unless you create a dedicated S3 service account/policy.
MINIO_ACCESS_KEY=sahool-admin
MINIO_SECRET_KEY=minio_pass_change_me
S3_ENDPOINT=http://sahool-minio:9000
S3_ENDPOINT_HOST=sahool-minio:9000
# Leave empty in local/dev to persist COGs as file:///data/rasters. Set in production
# to enable shared object storage, e.g. sahool-rasters.
S3_BUCKET=
S3_ACCESS_KEY=sahool-admin
S3_SECRET_KEY=minio_pass_change_me
S3_REGION=us-east-1
S3_USE_SSL=false
S3_ALLOW_FILE_FALLBACK=false
ZLMEDIA_API_URL=http://sahool-zlmediakit:8080
# ODOO_DB: قاعدة Odoo **منفصلة** عن قاعدة المنصّة (sahool) — وإلّا يفشل Odoo
# (relation "ir_module_module" does not exist). يهيّئها Odoo أوّل تشغيل (-i base؛
# يتطلّب CREATEDB لـsahool_user أو إنشاءها مسبقاً).
ODOO_URL=http://sahool-odoo:8069  # اسم الخدمة في compose (لا «odoo» — غير قابل للحلّ)
ODOO_DB=sahool_erp
ODOO_USER=admin
ODOO_PASSWORD=CHANGE_THIS
# دور قاعدة Odoo المقيَّد (لا مالك الهجرات sahool_user) — يُنشئه apply_in_compose.sh
# (LOGIN NOBYPASSRLS CREATEDB + سحب CONNECT من PUBLIC). غيّرهما في الإنتاج.
ODOO_DB_ROLE=odoo_app
ODOO_DB_PASSWORD=odoo_app_pw_change_me
SMTP_FROM=noreply@sahool.ye
FRONTEND_URL=https://app.sahool.ye
# ── مزوّد الذكاء (تحليل الحقول/المحادثة): محلّيّ Ollama ↔ Anthropic ↔ OpenRouter ──
# مفتاح موحَّد AI_PROVIDER: local (افتراضيّ، بلا مفاتيح سحابيّة) | anthropic | openrouter.
# يُحلّ في api/ai_provider_config.py؛ الواجهة تستدعي الـproxy فقط (لا يصل أيّ سرّ المتصفّح).
AI_PROVIDER=local
# النموذج الافتراضيّ (يُستخدَم إن لم تختر الواجهة): محلّيّاً qwen3، أو معرّف نموذج المزوّد.
AI_MODEL=qwen3
# كتالوج النماذج القابلة للاختيار من الواجهة (id|label مفصولة بفاصلة). قائمة سماح:
# الواجهة لا ترسل إلّا معرّفاً منها. مثال OpenRouter (DeepSeek/Claude Sonnet/Gemini 3 Pro):
# AI_MODELS=deepseek/deepseek-chat|DeepSeek,anthropic/claude-sonnet-4.6|Claude Sonnet,google/gemini-3-pro|Gemini 3 Pro
AI_MODELS=
# المحلّيّ (Ollama): الوجهة الافتراضيّة داخل الشبكة.
OLLAMA_BASE_URL=http://ollama:11434
# الخارجيّ (Anthropic): يُفعَّل فقط حين AI_PROVIDER=anthropic + مفتاح ونموذج (وإلّا fail-closed).
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
# OpenRouter (مُوجِّه متعدّد النماذج): يُفعَّل حين AI_PROVIDER=openrouter + OPENROUTER_API_KEY.
# يتيح اختيار DeepSeek/Claude Sonnet/Gemini 3 Pro وغيرها عبر AI_MODELS أعلاه.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# ترويسات OpenRouter الإرشاديّة (اختياريّة، للوسم في لوحة OpenRouter — ليست أسراراً).
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=SAHOOL
# حوكمة الذكاء للمستأجِر (V52): مسار ملفّ JSON يُدِيم سياسة كلّ مستأجِر (سماح التوليد +
# مستوى مشاركة البيانات local_only|redacted_external|full_external). فارغ ⇒ محلّيّ-العمليّة.
# مزوّد خارجيّ + local_only ⇒ يُحجَب سياق الحقل (سقوط آمن إلى الأدلّة). صيغة: {"tenant":{...}}.
TENANT_AI_POLICY_FILE=

# ── TTS Service (Yemeni Arabic) ────────────────────────────────
TTS_CACHE_TTL=86400
TTS_MAX_TEXT_LEN=1000

# ── احتياط اتّجاه الرياح: MET Norway (api.met.no، مفتوح المصدر CC-BY، عالميّ) ──
# يُستعمَل فقط حين يغيب اتّجاه الرياح من Open-Meteo (المزوّد الأساسيّ) — بدل قيمة وهميّة.
# MET.no يتطلّب User-Agent مُعرِّفاً (يرفض الطلبات بدونه). عطّله بـ=0 لبيئة معزولة.
METNO_WIND_FALLBACK_ENABLED=1
METNO_USER_AGENT=SAHOOL-AgriPlatform/1.0 (https://sahool.ye; ops@sahool.ye)

# مصدر احتياطي للأقمار: Microsoft Planetary Computer (STAC عامّ، بحث مجهول)
STAC_FALLBACK_ENABLED=true
PLANETARY_COMPUTER_URL=https://planetarycomputer.microsoft.com/api/stac/v1
# مصدر احتياطي ثانٍ: Digital Earth Africa (أفريقيا فقط — معطّل لليمن، فعّله لمناطق أفريقيّة)
DEAFRICA_ENABLED=false
DEAFRICA_STAC_URL=https://explorer.digitalearth.africa/stac

# نطاق nginx (localhost للتطوير المحلّي، نطاقك للإنتاج)
DOMAIN=localhost

# ─── مزوّد ERP: erpnext (الأساسي) | odoo (اختياري) | none (إيقاف) ───
# الأساسي ERPNext. شغّله عبر: docker compose -f docker-compose.erpnext.yml up -d
# ثمّ اضبط المفاتيح أدناه. بلا مفاتيح → الجسر يتدهور بصدق إلى none (لا اتّصال وهمي).
ERP_PROVIDER=erpnext
ERPNEXT_URL=http://sahool-erpnext:8000
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# (Odoo اختياريّ فقط: ERP_PROVIDER=odoo + docker compose --profile odoo up -d)

# ── مطلوبة لـdocker-compose.fixed.yml (كانت ناقصة فيُجهَض `up` بـ${VAR:?}) ──
# Redis: نفس كلمة السرّ تُستخدَم في requirepass وفي REDIS_URL.
REDIS_PASSWORD=
# Qdrant: مفتاح الـAPI لقاعدة المتّجهات (تأمين الوصول).
QDRANT_API_KEY=
# Telegram: سرّ توقيع الـwebhook (تحقّق صحّة طلبات تيليجرام الواردة).
TELEGRAM_WEBHOOK_SECRET=

# ── Compose contract defaults — keep docker-compose*.yml and .env aligned ──
# These are referenced by one or more compose files. Keep them centralized here to
# avoid drift, duplicate hardcoded values, and service-specific credential mismatches.
SAHOOL_ENV=development
TZ=UTC
CORS_ORIGINS=http://localhost:3000
WEB_PORT=3003
REACT_APP_API_URL=http://localhost/api
REACT_APP_WS_URL=ws://localhost/ws
VITE_API_URL=
VITE_WS_URL=/ws
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
SAHOOL_ALLOW_HS256_IN_PROD=false
# MFA enforcement for sensitive roles. Fail-safe: MFA is REQUIRED for these roles in
# production. Keep true here — disable ONLY in local dev via docker-compose.dev.yml.
ENFORCE_SENSITIVE_MFA=true
REQUIRE_MFA_ROLES=admin
# Tile-auth cookie (sahool_at, HttpOnly) — sent automatically with <img> tile requests so no
# JWT rides the URL. Secure=1 is correct for HTTPS. Serving over plain HTTP (local/staging)?
# Set AUTH_COOKIE_SECURE=0 — otherwise the browser withholds the cookie and the /api/raster
# auth_request gate 403s every tile in production builds (no URL-token fallback in prod).
# The dev frontend gateway (frontend/nginx.conf, :3003) now mirrors the prod identity
# contract: sahool_at cookie -> auth_request -> JWT-verified X-Tenant-Id -> raster.
# Zero-config alternative for pure local work: `npm run dev` (Vite) — import.meta.env.PROD
# is false, so tiles carry tid/access_token and the gateway isn't needed. Not an
# architectural substitute for the :3003 path.
AUTH_COOKIE_SECURE=auto
AUTH_COOKIE_SAMESITE=lax
APP_DB_ROLE=sahool_app
JOBS_DB_ROLE=sahool_jobs
DB_USER=sahool_user
EARTH_SEARCH_URL=https://earth-search.aws.element84.com/v1
# مزوّد البحث التاريخيّ (backfill): element84 = صور خام مباشرة (بلا وحدات معالجة CDSE)؛
# cdse = Copernicus Process API (يتطلّب رصيد معالجة).
HISTORICAL_SEARCH_PROVIDER=element84
# بوّابة تفعيل satellite_cdse (P2-c): 0 = معطَّلة (اختيار المزوّد ثابت كما أعلاه)؛ 1 = يستشير
# raster-service قرار decision-service قبل اختيار CDSE ويسقط مُغلَقاً إلى element84 عند التعذُّر.
RASTER_ACTIVATION_GATE_ENFORCE=0
# معرّف بيئة التفعيل (يطابق جانب البوّابة في decision-service).
ACTIVATION_ENVIRONMENT_ID=default
STAC_CACHE_TTL=3600
STAC_MAX_RETRIES=3
RASTER_SERVICE_URL=http://sahool-raster-service:8001
# انتظار اكتمال دفعة المؤشّرات قبل قراءة نتائجها (SPECTRAL-COLLECTOR-ASYNC-RACE-01).
# `/v1/process/batch` غير متزامن، والقراءة الفوريّة كانت تصطدم بـ404 دائماً فلا تُكتَب
# أيّ قيمة طيفيّة. صفر = تعطيل الانتظار وعودة السلوك السابق حرفيّاً (بوّابة تراجع
# تشغيليّة). العدّادات terminal/timed_out/unknown تُعرَض في حالة أتمتة الصور.
IMAGERY_BATCH_WAIT_BUDGET_S=120
IMAGERY_BATCH_POLL_INTERVAL_S=2
# عدد الحقول المفحوصة معاً في كنسة واحدة (IMAGERY-SCAN-SERIAL-WAIT-01). المرور كان
# تسلسليّاً فصار أسوأ حالة للدورة = عدد الحقول × ميزانيّة الانتظار أعلاه. الحدّ الأدنى ١
# (تسلسليّ)؛ صفر أو سالب يُرفَع إلى ١ لأنّه يعني تعليقاً تامّاً لا «بلا حدّ».
IMAGERY_SCAN_CONCURRENCY=8
# field-management-service: declared owner of the `fields` table. vegetation reads
# tenant-scoped fields from here with its service token (service-token only, no JWT).
FIELD_SERVICE_URL=http://sahool-field-management:8000
TITILER_URL=http://sahool-titiler:8000
TITILER_IMAGE=ghcr.io/developmentseed/titiler:0.18.6
AWS_VIRTUAL_HOSTING=false
RASTER_ASYNC_BACKFILL_ENABLED=true
RASTER_CACHE_INVALIDATION_ENABLED=true
RASTER_LAYER_EVICT_ENABLED=true
RASTER_MAX_READ_DIM=4096
TILE_CACHE_TTL_SECONDS=3600
TILE_CACHE_MAX_BYTES=1073741824
WORKER_POLL_SECONDS=5
CDSE_PROCESS_MIN_INTERVAL_SECONDS=2.0
CDSE_PROCESS_MAX_RETRIES=5
CDSE_PROCESS_RETRY_BASE_SECONDS=5
CDSE_PROCESS_RETRY_MAX_SECONDS=120
# سياسة غيوم المشهد عند تعذّر إثبات الجودة (SILENT-EXCEPTION-HANDLERS-11-01):
#   strict (افتراض) = بيانات `eo:cloud_cover` التالفة تُرفَض؛ الغائبة تُقبَل وتُعَدّ.
#   allow_unknown   = عقد صريح يقبل التالف أيضاً — يُطلَب صراحةً ولا يُورَث صامتاً.
# القبول مُسجَّل في الحالتين عبر عدّادات sahool_raster_cdse_metadata_* في /metrics.
CDSE_CLOUD_POLICY=strict
COPERNICUS_USER=
COPERNICUS_PASSWORD=
WEATHER_SERVICE_URL=http://sahool-weather-service:8000
WEATHER_HORIZON_HOURS=48
# مهلة نداء Open-Meteo داخل weather-service (ثوانٍ) — افتراضيّ 4
WEATHER_OPEN_METEO_TIMEOUT_S=4
# قاطع دائرة Open-Meteo: عدد الإخفاقات قبل الفتح + ثواني إعادة المحاولة
WEATHER_OPEN_METEO_BREAKER_FAILURES=3
WEATHER_OPEN_METEO_BREAKER_RESET_S=30
# جاهزيّة edge-inference: partial (افتراضيّ آمن) أو strict؛ والإلزام الإنتاجيّ خلف راية
EDGE_READINESS_MODE=partial
EDGE_PRODUCTION_REQUIRED=false
# نمط نشر NATS لخدمة النباتات: best_effort (افتراضيّ — لا يحجب الإقلاع/الجاهزيّة)
VEGETATION_NATS_PUBLISH_MODE=best_effort
WEATHER_SIGNAL_INTERVAL_SEC=3600
SOIL_SERVICE_URL=http://sahool-soil-service:8000
# decision-service = INTERIM best-effort mirror (dual-path): sahool-platform is the
# authoritative Source-of-Record; the platform mirrors writes here and swallows failures.
DECISION_SERVICE_URL=http://sahool-decision-service:8160
# DEPLOYED-DECISION-SOR-PROMOTION (opt-in, default OFF): keep these empty/false so decision-service
# stays an honest mirror (sor_enabled() is false). At cutover set DECISION_SERVICE_DATABASE_URL to a
# restricted (non-superuser, non-BYPASSRLS) role and DECISION_SERVICE_SOR_ENABLED=true only after
# migrations + backfill + review-quarantine verify (scripts/deploy/decision_service_migrate.sh).
DECISION_SERVICE_DATABASE_URL=
DECISION_SERVICE_SOR_ENABLED=false

# DECISION-CENTER-UNIFY-01 gates (default false = fail-closed / correct posture):
#  CROP_TWIN_DIRECT_DECISION_ENABLED=true is a STAGING gate for the governed candidate path
#    only: /crop-twin/decision-candidate accepts submit=true (candidate still built from
#    client inputs → pending_approval in decision-service). Leave false in production.
#    NOTE (Slice 2): /crop-twin/decision + /profit-aware are now PERMANENTLY preview/scenario
#    only (preview_only=true, never persist) — the legacy direct-write side-door was removed,
#    this flag no longer affects them.
CROP_TWIN_DIRECT_DECISION_ENABLED=false
#  FIELD_INTELLIGENCE_DIRECT_EXECUTABLE_ENABLED=true restores the legacy field-intelligence
#    gate where guardrails clearance alone marks a policy executable. Leave false so a
#    decision-center pass is required (the flag is display-only; real dispatch is separate).
FIELD_INTELLIGENCE_DIRECT_EXECUTABLE_ENABLED=false
SOILGRIDS_DIR=/data/soilgrids
FIELD_DEM_PATH=
SYNC_INTERVAL=60
OUTBOX_MAX_ATTEMPTS=5
PHASE_RUNTIME_PERSISTENCE_REQUIRED=true
MODEL_SERVING_ROLLBACK_ENABLED=true
PLUGIN_EXECUTION_ENABLED=false
PHYSICAL_ACTUATION_ENABLED=false
VIDEO_STRICT_READY=true
MAX_CONCURRENT_STREAMS=4
FRAME_INTERVAL_SEC=5
EXG_MAX_IMAGE_PIXELS=25000000
EXG_MAX_SIDE=8192
SEGMENTATION_BACKEND=sam2
SEGMENTATION_URL=http://sahool-field-segmentation:8000
SEGMENTATION_INFERENCE_URL=http://sahool-sam2-inference:8000
SEGMENTATION_MODEL_PATH=/models/sam2
SAM2_CHECKPOINT=
SAM2_MODEL_CFG=
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,video
CUDA_MODULE_LOADING=LAZY
TORCH_CUDA_ARCH_LIST=
PYTORCH_CUDA_IMAGE=pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
PIP_INDEX_URL=https://pypi.org/simple
PIP_EXTRA_INDEX_URL=
ZLMEDIAKIT_IMAGE=zlmediakit/zlmediakit@sha256:REPLACE_WITH_VERIFIED_64_HEX_DIGEST
ZLMEDIAKIT_API_SECRET=CHANGE_THIS_ZLMEDIAKIT_SECRET
ZLM_API_SECRET=CHANGE_THIS_ZLMEDIAKIT_SECRET
JAEGER_IMAGE=jaegertracing/all-in-one:1.62.0
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z
OLLAMA_IMAGE=ollama/ollama:latest
QDRANT_COLLECTION=sahool_rag
EMBEDDING_DIM=768
EMBED_MODEL=nomic-embed-text
LLM_MODEL=llama3.2:3b
NUM_CTX=4096
NL_SQL_MODEL=qwen2.5-coder:7b
RAG_RETRIEVAL_URL=http://sahool-rag-retrieval:8000
KNOWLEDGE_GRAPH_URL=http://sahool-knowledge-graph:8000
AI_AGRONOMIST_URL=http://sahool-ai-agronomist:8000
SAHOOL_AGENT_STORE_BACKEND=redis
SAHOOL_AGENT_REDIS_URL=redis://:${REDIS_PASSWORD}@sahool-redis:6379/0
TTS_PROVIDER=local
TTS_GPU_PROVIDER=cpu
FEATURE_DECISION_CONFIDENCE=false
FEATURE_DECISION_STUDIO=false
FEATURE_DELTA_SYNC=false
FEATURE_DEVICE_TWIN=false
FEATURE_EVIDENCE_MAP=false
FEATURE_EXECUTION_FEEDBACK=false
FEATURE_GIS_KERNEL=false
FEATURE_IRRIGATION_NETWORK=false
# IRR-F01 Gate B-delivery Slice B-d2-live: relay reservation dispatch events (NATS) → decision-service
# inbox. Default off (events rest in the outbox). Relay worker is also gated by the `relay` compose profile.
FEATURE_RESERVATION_DISPATCH_RELAY=false
FEATURE_LEARNING_DASHBOARD=false
FEATURE_NATURAL_LANGUAGE_GIS=false
FEATURE_OPERATIONS_WALL=false
FEATURE_PORTFOLIO_COMMAND=false
FEATURE_REPLAY_MAP=false
FEATURE_UNIFIED_LINEAGE=false
ERPNEXT_VERSION=v15.0.0
ERPNEXT_SITE=sahool.localhost
ERPNEXT_DB_PASSWORD=erpnext_db_pass_change_me
ERPNEXT_ADMIN_PASSWORD=erpnext_admin_pass_change_me
ODOO_API_KEY=
WEBHOOK_SECRET=

# Governed agricultural decision evidence (AC-1/AC-6 staged enforcement flags)
# Staged rollout outside production. In production/prod AC-1 is always required
# even when this value is absent or false.
DECISION_REQUIRE_AGRONOMIC_CONTEXT=false
# HISTORICAL-SEASON-BRIDGE-01: مرآة AC-1 إلى decision-service؛ مغلقة حتى إثبات SoR حي.
HISTORICAL_SEASON_DECISION_CONTEXT_ENABLED=false
# Fail-closed in production/staging: no real processed observation ⇒ 424 (never a
# synthetic NDVI). Development soft-fail (available:false, 200) lives in .env.development
# as VEGETATION_REAL_ONLY=0 — do NOT set 0 here; the production template stays fail-closed.
VEGETATION_REAL_ONLY=1
AGRIAI_PRODUCTION_MODE=false
AGRIAI_STRICT_CONTEXT=false
VEGETATION_EVIDENCE_PUSH_ENABLED=false
RUNTIME_TENANT_IDS=

# Decision-service multitenancy hardening (73666ee forensic audit) — staged production flags.
# AUTH_TOKEN: shared bearer required on every non-probe decision-service request when set.
# REQUIRE_AUTH_TOKEN (F-09): SoR mode without AUTH_TOKEN → /readyz degraded (fail-closed).
# STRICT_WORKER_TENANTS (F-01): unregistered runtime workers are DENIED all tenants.
DECISION_SERVICE_AUTH_TOKEN=
DECISION_REQUIRE_AUTH_TOKEN=false
DECISION_STRICT_WORKER_TENANTS=false
# WORKER-IDENTITY-BINDING (staged): when set, the worker-driven endpoints require a request-scoped
# X-Worker-Assertion proving the caller IS the worker_id (subject) — set the SAME key on the adapter
# below. Unset = header-only compatibility (dev / existing installs); REQUIRED in production.
# Must be >= 32 chars. The Redis URL is the nonce replay store (production never uses process memory).
DECISION_WORKER_ASSERTION_KEY=
DECISION_WORKER_ASSERTION_KEY_ID=current
DECISION_WORKER_ASSERTION_PREVIOUS_KEY=
DECISION_WORKER_ASSERTION_PREVIOUS_KEY_ID=previous
DECISION_WORKER_ASSERTION_REDIS_URL=

# WX-12 model-lifecycle adapter (compose profile `model-lifecycle`, opt-in).
# The adapter fails closed in production without its external backend URLs/tokens.
# REGISTRY_ADAPTER_ID is the worker identity used against the worker→tenant registry.
# It signs X-Worker-Assertion with DECISION_WORKER_ASSERTION_KEY (must MATCH the decision-service).
REGISTRY_ADAPTER_ID=
RUNTIME_TENANT_ID=
RUNTIME_POLL_INTERVAL_SECONDS=10
MODEL_TRAFFIC_CONTROLLER_URL=
MODEL_TRAFFIC_CONTROLLER_TOKEN=
MODEL_INFERENCE_VERIFY_URL=
MODEL_INFERENCE_VERIFY_TOKEN=
MODEL_METRICS_SOURCE_URL=
MODEL_METRICS_SOURCE_TOKEN=
MODEL_TRAINING_BACKEND_URL=
MODEL_TRAINING_BACKEND_TOKEN=

# WATER-LEDGER-AUTO: أتمتة ميزان الماء اليوميّ (FAO-56) — عامل يكتب water_ledger آليّاً
# لكلّ حقل بموسم نشط. الافتراض off (لا كتابة صامتة)؛ القيد اليدويّ يبقى سيّداً.
WATER_LEDGER_AUTO_ENABLED=false
WATER_LEDGER_POLL_SECONDS=3600

# ACTUATOR-DISPATCH-CONSUMER: جسر القرار→التنفيذ الفيزيائيّ (P0 تدقيق المستهلكين).
# default-OFF؛ التفعيل يتطلّب تعيين المستأجرين صراحةً — قائمة فارغة = حلقة خاملة.
FEATURE_DISPATCH_ACTUATOR=
ACTUATOR_DISPATCH_TENANT_IDS=
ACTUATOR_DISPATCH_POLL_SECONDS=10
ACTUATOR_DISPATCH_RISK_ALLOWLIST=

# WATER-DEFICIT-BRIDGE: جسر عجز الماء المحكوم (default-off مزدوج). التسلسل التشغيليّ:
# SoR ⇒ WATER_LEDGER_AUTO ⇒ الجسر (مراجعة بشريّة) ⇒ هدف staging + auto-execution محاكاةً.
WATER_DEFICIT_DECISION_BRIDGE_ENABLED=false
WATER_DEFICIT_DECISION_THRESHOLD_MM=10
WATER_DEFICIT_POLICY_VERSION=water-deficit.v1
WATER_DEFICIT_AUTO_EXECUTION_ENABLED=false
WATER_DEFICIT_EXECUTION_TARGET_TYPE=equipment
WATER_DEFICIT_EXECUTION_TARGET_ID=
WATER_DEFICIT_POLICY_ACTOR=water-deficit-policy

# تصلّب سلامة أجهزة المُشغّل: نضارة السجلّ (ثوانٍ) + مفتاح توكن التسليم الحتميّ (HMAC)
# لاسترداد الإيصالات بعد إعادة التشغيل — غيابه مع غياب DECISION_SERVICE_AUTH_TOKEN = جسر مقفل.
ACTUATOR_DEVICE_STALE_SECONDS=900
ACTUATOR_DELIVERY_TOKEN_KEY=

# RIV: مهلة مطالبة دفعة المؤشّرات (idempotency) في raster-service — ثوانٍ
RASTER_BATCH_CLAIM_TTL_SECONDS=86400
# v154: مدّة إيجار مطالبة الدفعة (ثوانٍ) قبل السماح باستردادها من عامل آخر بعد تعطُّل
RASTER_BATCH_LEASE_SECONDS=300
# معرّف العامل لمالك الإيجار (heartbeat/terminal يتطلّبان العامل + رمز الإيجار معاً)
RASTER_WORKER_ID=raster-api
# v154 heartbeat: تجديد الإيجار دوريّاً لمؤشّر طويل التشغيل (0 = اشتقاق تلقائيّ = ثلث مدّة الإيجار)
RASTER_BATCH_HEARTBEAT_SECONDS=0

# Soil P0 (v155/v156) — agronomic/soil evidence enforcement (operator-tunable).
# Defaults are production-safe in compose; set to false on a stack without populated
# agronomic context / soil profiles to avoid fail-closed decisions until data exists.
DECISION_REQUIRE_SOIL_PROFILE=false
DECISION_REQUIRE_SOIL_EVIDENCE_GATE=false
# مخزن الشذوذ (RS-6): sqlite (افتراضيّ، نسخة واحدة) أو postgres (توسّع أفقيّ + RLS، v191).
# postgres يحتاج DATABASE_URL على دور sahool_app؛ يُفعَّل بعد شهادة PG حيّ في staging.
VEGETATION_ANOMALY_STORE=sqlite

# Gate-Trust-1 Slice 2 — activation gate production hardening (decision-service). Default OFF
# (transitional; the mirror deployment stays functional). At production cutover set
# ACTIVATION_REQUIRE_PRODUCTION_HARDENING=true: startup then hard-fails unless DEPLOY_BUILD_SHA +
# ACTIVATION_PROBE_SIGNING_KEY + IRR_F01_RESERVATION_ENFORCE_ACTIVATION are set, and CI-issued
# (external) evidence receipts must carry a valid HMAC signature (ACTIVATION_EVIDENCE_SIGNING_KEY_CI).
ACTIVATION_REQUIRE_PRODUCTION_HARDENING=false
# DEPLOY_BUILD_SHA: the deployed build's immutable identity (40- or 64-char lowercase hex). Bound
# into every activation verdict; the gate fails closed if it is absent or malformed. Production MUST
# inject the exact tested commit SHA. For local dev/test use .env.development (a pinned placeholder).
DEPLOY_BUILD_SHA=
ACTIVATION_PROBE_SIGNING_KEY=
# ACTIVATION_EVIDENCE_SIGNING_KEY: trust root for stored producer-issued evidence receipts. Required
# to ingest or resolve any receipt (both paths return 503 without it). Secret-manager-backed in prod.
# KEY ISOLATION (ledger #3): this MUST be a DISTINCT secret value from JWT_SECRET, SAHOOL_AGENT_TOKEN,
# and ACTIVATION_PROBE_SIGNING_KEY. Reusing one secret across trust domains means a leak of the
# service/auth secret also forges activation evidence. The compose contract keeps them separate
# variables (locked by tests_v9/test_activation_signing_key_isolation_guard.py); provisioning
# distinct VALUES is the operator's duty — do not paste the same string into two of these.
ACTIVATION_EVIDENCE_SIGNING_KEY=
IRR_F01_RESERVATION_ENFORCE_ACTIVATION=false

# SIM-PCSE-01: تفعيل محرّك PCSE/WOFOST (افتراضيّاً off — الأمانة القائمة تبقى؛ يُشعَل في التكامل حيث يُركَّب pcse).
SIM_PCSE_ENABLED=0

# MQTT — الوسيط الداخليّ (sahool-fastbee) يرفض الوصول المجهول (allow_anonymous false).
# اسم/كلمة مرور إلزاميّان: يُولَّد passwd للوسيط منهما عند الإقلاع، ويصادق العميلان
# (actuator-service / video-processor) بهما. سرّ حقيقيّ من مدير الأسرار في الإنتاج.
MQTT_USERNAME=sahool
MQTT_PASSWORD=

# ── Evidence Lab (ephemeral, loopback-only; docker-compose.evidence-lab.yml) ──
# منافذ مختبر الأدلّة المحلّيّة (127.0.0.1 فقط) — لا علاقة لها ببيئات الإنتاج/staging.
EVIDENCE_PG_PORT=55432
EVIDENCE_REDIS_PORT=56379
EVIDENCE_NATS_PORT=54222
EVIDENCE_NATS_MONITOR_PORT=58222
EVIDENCE_MINIO_PORT=59000
EVIDENCE_MINIO_CONSOLE_PORT=59001
EVIDENCE_WIREMOCK_PORT=58080

# DECISION-CENTER Composer — جلب الطيف الحاكم خادميّاً من raster-service للحقول الحقيقيّة
# (بدل الوثوق بمدخلات العميل في مسار القرار). افتراض معطَّل — التفعيل قرار تشغيليّ.
COMPOSE_SERVER_AUTHORITATIVE_SPECTRAL_ENABLED=0

# ── هويّة البناء غير القابلة للتغيير (runtime-verification / provenance) ──
# تُمرَّر كـbuild-args وقت بناء الصورة (تضبطها ورشة CI ذاتيّاً: GITHUB_* من بيئة Actions).
# محلّيّاً للبناء اليدويّ فقط؛ لا لزوم لها للتشغيل. TESTED_SHA وSAHOOL_BUILD_ID مطلوبان
# للبناء المُوثَّق (يفشل البناء إن غابا) — اضبطهما عند بناء صور مُوقَّعة محلّيّاً.
# TESTED_SHA is declared but intentionally EMPTY. Declared, because
# compose_env_contract_gate requires every ${VAR} a compose file references to exist
# here. Empty, because docker-compose.v9.yml uses ${TESTED_SHA:?...} and the ":?" form
# treats empty exactly like unset -- so the build still refuses rather than stamping an
# image with an identity nobody verified. Resolve it from git rev-parse HEAD via
# scripts/build-immutable.sh (or .ps1). Never use "local" here.
# TESTED_SHA=<full-40-character-git-sha>
TESTED_SHA=
# SAHOOL_BUILD_ID مُعلَن وفارغ للسبب نفسه الذي أُفرِغت لأجله TESTED_SHA: العقد يطلب
# ${SAHOOL_BUILD_ID:?...} وصيغة ":?" تعامل الفارغ كالغائب، فيرفض البناء بدل وسم صورة
# بهويّة لم تُشتقّ من شيء. المُغلِّف يشتقّها local-<sha12> من HEAD.
SAHOOL_BUILD_ID=
GITHUB_REPOSITORY=local/unknown
GITHUB_REF=local
