# SAHOOL v9.0 — .env.example
# ⚠️ أنشئ .env بنسخ هذا الملف: cp .env.example .env
# ⚠️ عدّل كل القيم قبل الإنتاج

# Database
# ملاحظة: compose يستخدم DB_PASSWORD (وuser=sahool_user) — وُحّد الاسمان هنا.
POSTGRES_PASSWORD=sahool_db_pass_change_me
DB_PASSWORD=sahool_db_pass_change_me
# ── نموذج الدورين (أمان RLS) ──────────────────────────────────────
# المالك sahool_user مُمتاز (superuser) ويُجري الهجرات فقط؛ superuser يتجاوز RLS
# حتى مع FORCE. لذلك التطبيق يتّصل بالدور المقيّد sahool_app (NOBYPASSRLS) عبر
# DATABASE_URL أدناه ليبقى عزل المستأجرين فعّالاً. يُنشئ sahool_app سكربت
# migrations/bootstrap_postgres.sh مستخدماً APP_DB_PASSWORD التالي.
APP_DB_PASSWORD=sahool_app_pass_change_me

# Auth (REQUIRED: أنشئ بـ: openssl rand -hex 32)
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_SECRET_BEFORE_PRODUCTION_USE__MIN32

# MinIO
MINIO_ROOT_USER=sahool
MINIO_ROOT_PASSWORD=minio_pass_change_me

# Grafana
GRAFANA_PASSWORD=grafana_pass_change_me

# Sentinel Hub (https://www.sentinel-hub.com/develop/api/)
SH_CLIENT_ID=
SH_CLIENT_SECRET=
SH_INSTANCE_ID=

# Copernicus Data Space Ecosystem (CDSE) — مجّاني، Sentinel-1/2 عبر Sentinel Hub APIs
# سجّل في https://dataspace.copernicus.eu ثمّ أنشئ OAuth client
# ⚠️ لا تضع القيم هنا — ضعها في .env المحلّي (غير المرفوع)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
SH_BASE_URL=https://sh.dataspace.copernicus.eu
SH_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
# CDSE هو المزوّد الافتراضيّ للصور (أقوى)؛ عند غياب الاعتمادات أو CDSE_ENABLED=false
# يسقط النظام تلقائيّاً إلى Element84 Earth Search (المسار القائم). لتعطيله: CDSE_ENABLED=false
CDSE_ENABLED=true

# Telegram Bot (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# Claude AI (https://console.anthropic.com)
VITE_CLAUDE_API_KEY=

# Supervisor Agent
SAHOOL_AGENT_TOKEN=

# Edge
EDGE_DEVICE=rpi5
OFFLINE_MODE=false
EDGE_SYNC_TOKEN=

# ── SAM2 حدود الحقل (تنظيف مضلّع القناع) — تُضبَط على sahool-sam2-inference ──
# تبسيط الحدّ بالأمتار (يُزيل «درج البكسل» ورؤوسه شبه المكرّرة). ارفعه لحدود أنعم.
SAM2_POLYGON_SIMPLIFY_TOLERANCE_M=3
# مسافة دمج الرؤوس المتتالية شبه المكرّرة بالأمتار (تنظيف إضافيّ بعد التبسيط).
SAM2_POLYGON_DEDUP_TOLERANCE_M=0.5

# ── الواجهة: خريطة أساس Mapbox (اختياريّة) — تظهر فقط عند ضبط المفتاح ──
# بدونها يبقى Esri World Imagery الافتراضيّ (بلا مفتاح) فلا تنكسر الخريطة.
VITE_MAPBOX_TOKEN=
VITE_MAPTILER_KEY=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Models
MODELS_BASE_URL=https://github.com/sahool-ai/models/releases/download/v9.0

# التطبيق يتّصل بالدور المقيّد sahool_app (لا sahool_user) ليبقى RLS فعّالاً.
# للهجرات/الإدارة فقط استعمل: postgresql://sahool_user:${DB_PASSWORD}@sahool-postgres:5432/sahool
DATABASE_URL=postgresql://sahool_app:${APP_DB_PASSWORD}@sahool-postgres:5432/sahool
# مسار المهامّ الخلفيّة (مرسِل event_outbox/مجدوِل الطقس) يقرأ عابراً للمستأجرين بالتصميم
# ⇒ دور sahool_jobs (BYPASSRLS، يُنشئه apply_in_compose.sh بكلمة JOBS_DB_PASSWORD).
# مطلوب في الإنتاج (RLS مُفعَّلة)، وإلّا يفشل المرسِل تحت RLS على event_outbox.
JOBS_DB_PASSWORD=sahool_jobs_pass_change_me
JOBS_DATABASE_URL=postgresql://sahool_jobs:${JOBS_DB_PASSWORD}@sahool-postgres:5432/sahool
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
SENTINEL_HUB_API_KEY=
WEATHER_API_KEY=
MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
ZLMEDIA_API_URL=http://sahool-zlmediakit:8080
# ODOO_DB: قاعدة Odoo **منفصلة** عن قاعدة المنصّة (sahool) — وإلّا يفشل Odoo
# (relation "ir_module_module" does not exist). يهيّئها Odoo أوّل تشغيل (-i base؛
# يتطلّب CREATEDB لـsahool_user أو إنشاءها مسبقاً).
ODOO_URL=http://sahool-odoo:8069  # اسم الخدمة في compose (لا «odoo» — غير قابل للحلّ)
ODOO_DB=sahool_erp
ODOO_USER=admin
ODOO_PASSWORD=CHANGE_THIS
SMTP_FROM=noreply@sahool.ye
FRONTEND_URL=https://app.sahool.ye
# ── مزوّد الذكاء (تحليل الحقول/المحادثة): محلّيّ Ollama ↔ Anthropic ↔ OpenRouter ──
# مفتاح موحَّد AI_PROVIDER: local (افتراضيّ، بلا مفاتيح سحابيّة) | anthropic | openrouter.
# يُحلّ في api/ai_provider_config.py؛ الواجهة تستدعي الـproxy فقط (لا يصل أيّ سرّ المتصفّح).
AI_PROVIDER=local
# النموذج الافتراضيّ (يُستخدَم إن لم تختر الواجهة): محلّيّاً qwen3، أو معرّف نموذج المزوّد.
AI_MODEL=qwen3
# كتالوج النماذج القابلة للاختيار من الواجهة (id|label مفصولة بفاصلة). قائمة سماح:
# الواجهة لا ترسل إلّا معرّفاً منها. مثال OpenRouter (DeepSeek/Claude Sonnet/Gemini 3 Pro):
# AI_MODELS=deepseek/deepseek-chat|DeepSeek,anthropic/claude-sonnet-4.6|Claude Sonnet,google/gemini-3-pro|Gemini 3 Pro
AI_MODELS=
# المحلّيّ (Ollama): الوجهة الافتراضيّة داخل الشبكة.
OLLAMA_BASE_URL=http://ollama:11434
# الخارجيّ (Anthropic): يُفعَّل فقط حين AI_PROVIDER=anthropic + مفتاح ونموذج (وإلّا fail-closed).
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
# OpenRouter (مُوجِّه متعدّد النماذج): يُفعَّل حين AI_PROVIDER=openrouter + OPENROUTER_API_KEY.
# يتيح اختيار DeepSeek/Claude Sonnet/Gemini 3 Pro وغيرها عبر AI_MODELS أعلاه.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# ترويسات OpenRouter الإرشاديّة (اختياريّة، للوسم في لوحة OpenRouter — ليست أسراراً).
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=SAHOOL
# حوكمة الذكاء للمستأجِر (V52): مسار ملفّ JSON يُدِيم سياسة كلّ مستأجِر (سماح التوليد +
# مستوى مشاركة البيانات local_only|redacted_external|full_external). فارغ ⇒ محلّيّ-العمليّة.
# مزوّد خارجيّ + local_only ⇒ يُحجَب سياق الحقل (سقوط آمن إلى الأدلّة). صيغة: {"tenant":{...}}.
TENANT_AI_POLICY_FILE=

# ── TTS Service (Yemeni Arabic) ────────────────────────────────
TTS_CACHE_TTL=86400
TTS_MAX_TEXT_LEN=1000

# ── احتياط اتّجاه الرياح: MET Norway (api.met.no، مفتوح المصدر CC-BY، عالميّ) ──
# يُستعمَل فقط حين يغيب اتّجاه الرياح من Open-Meteo (المزوّد الأساسيّ) — بدل قيمة وهميّة.
# MET.no يتطلّب User-Agent مُعرِّفاً (يرفض الطلبات بدونه). عطّله بـ=0 لبيئة معزولة.
METNO_WIND_FALLBACK_ENABLED=1
METNO_USER_AGENT=SAHOOL-AgriPlatform/1.0 (https://sahool.ye; ops@sahool.ye)

# مصدر احتياطي للأقمار: Microsoft Planetary Computer (STAC عامّ، بحث مجهول)
STAC_FALLBACK_ENABLED=true
PLANETARY_COMPUTER_URL=https://planetarycomputer.microsoft.com/api/stac/v1
# مصدر احتياطي ثانٍ: Digital Earth Africa (أفريقيا فقط — معطّل لليمن، فعّله لمناطق أفريقيّة)
DEAFRICA_ENABLED=false
DEAFRICA_STAC_URL=https://explorer.digitalearth.africa/stac

# نطاق nginx (localhost للتطوير المحلّي، نطاقك للإنتاج)
DOMAIN=localhost

# ─── مزوّد ERP: erpnext (الأساسي) | odoo (اختياري) | none (إيقاف) ───
# الأساسي ERPNext. شغّله عبر: docker compose -f docker-compose.erpnext.yml up -d
# ثمّ اضبط المفاتيح أدناه. بلا مفاتيح → الجسر يتدهور بصدق إلى none (لا اتّصال وهمي).
ERP_PROVIDER=erpnext
ERPNEXT_URL=http://sahool-erpnext:8000
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# (Odoo اختياريّ فقط: ERP_PROVIDER=odoo + docker compose --profile odoo up -d)

# ── مطلوبة لـdocker-compose.fixed.yml (كانت ناقصة فيُجهَض `up` بـ${VAR:?}) ──
# Redis: نفس كلمة السرّ تُستخدَم في requirepass وفي REDIS_URL.
REDIS_PASSWORD=
# Qdrant: مفتاح الـAPI لقاعدة المتّجهات (تأمين الوصول).
QDRANT_API_KEY=
# Telegram: سرّ توقيع الـwebhook (تحقّق صحّة طلبات تيليجرام الواردة).
TELEGRAM_WEBHOOK_SECRET=
