# SAHOOL v9.0 — .env.example
# ⚠️ أنشئ .env بنسخ هذا الملف: cp .env.example .env
# ⚠️ عدّل كل القيم قبل الإنتاج

# Database
# ملاحظة: compose يستخدم DB_PASSWORD (وuser=sahool_user) — وُحّد الاسمان هنا.
POSTGRES_PASSWORD=sahool_db_pass_change_me
DB_PASSWORD=sahool_db_pass_change_me

# Auth (REQUIRED: أنشئ بـ: openssl rand -hex 32)
JWT_SECRET=CHANGE_THIS_64_CHAR_SECRET_NOW

# MinIO
MINIO_ROOT_USER=sahool
MINIO_ROOT_PASSWORD=minio_pass_change_me

# Grafana
GRAFANA_PASSWORD=grafana_pass_change_me

# Sentinel Hub (https://www.sentinel-hub.com/develop/api/)
SH_CLIENT_ID=
SH_CLIENT_SECRET=
SH_INSTANCE_ID=

# Copernicus Data Space Ecosystem (CDSE) — مجّاني، Sentinel-1/2 عبر Sentinel Hub APIs
# سجّل في https://dataspace.copernicus.eu ثمّ أنشئ OAuth client
# ⚠️ لا تضع القيم هنا — ضعها في .env المحلّي (غير المرفوع)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
SH_BASE_URL=https://sh.dataspace.copernicus.eu
SH_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token

# Telegram Bot (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# Claude AI (https://console.anthropic.com)
VITE_CLAUDE_API_KEY=

# Supervisor Agent
SAHOOL_AGENT_TOKEN=

# Edge
EDGE_DEVICE=rpi5
OFFLINE_MODE=false
EDGE_SYNC_TOKEN=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Models
MODELS_BASE_URL=https://github.com/sahool-ai/models/releases/download/v9.0

DATABASE_URL=postgresql://sahool_user:${DB_PASSWORD}@sahool-postgres:5432/sahool
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
SENTINEL_HUB_API_KEY=
WEATHER_API_KEY=
MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
ZLMEDIA_API_URL=http://sahool-zlmediakit:8080
# ODOO_DB: قاعدة Odoo **منفصلة** عن قاعدة المنصّة (sahool) — وإلّا يفشل Odoo
# (relation "ir_module_module" does not exist). يهيّئها Odoo أوّل تشغيل (-i base؛
# يتطلّب CREATEDB لـsahool_user أو إنشاءها مسبقاً).
ODOO_URL=http://sahool-odoo:8069  # اسم الخدمة في compose (لا «odoo» — غير قابل للحلّ)
ODOO_DB=sahool_erp
ODOO_USER=admin
ODOO_PASSWORD=CHANGE_THIS
SMTP_FROM=noreply@sahool.ye
FRONTEND_URL=https://app.sahool.ye
# ── TTS Service (Yemeni Arabic) ────────────────────────────────
TTS_CACHE_TTL=86400
TTS_MAX_TEXT_LEN=1000

# مصدر احتياطي للأقمار: Microsoft Planetary Computer (STAC عامّ، بحث مجهول)
STAC_FALLBACK_ENABLED=true
PLANETARY_COMPUTER_URL=https://planetarycomputer.microsoft.com/api/stac/v1
# مصدر احتياطي ثانٍ: Digital Earth Africa (أفريقيا فقط — معطّل لليمن، فعّله لمناطق أفريقيّة)
DEAFRICA_ENABLED=false
DEAFRICA_STAC_URL=https://explorer.digitalearth.africa/stac

# نطاق nginx (localhost للتطوير المحلّي، نطاقك للإنتاج)
DOMAIN=localhost

# ─── مزوّد ERP: odoo | erpnext | none (إيقاف) ───
