{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/uwrp/external-action/v3",
  "title": "UWRP v3 external action tracking (NOT an authorization grant)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "work_id", "operation_id", "target", "action", "authorization", "status", "reconciliation_plan"],
  "properties": {
    "schema_version": {"const": "uwrp/external-action/v3"},
    "example_only": {"type": "boolean"},
    "work_id": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "target": {"type": "object", "additionalProperties": false, "required": ["kind", "resource_id"], "properties": {
      "kind": {"type": "string", "minLength": 1},
      "resource_id": {"type": "string", "minLength": 1}
    }},
    "action": {"type": "string", "minLength": 1},
    "authorization": {"type": "object", "additionalProperties": false, "required": ["verified", "source_ref"], "properties": {
      "verified": {"type": "boolean"},
      "source_ref": {"type": ["string", "null"]}
    }},
    "request_digest": {"type": ["string", "null"]},
    "expected_before": {"type": ["string", "null"]},
    "external_idempotency_supported": {"enum": ["YES", "NO", "UNKNOWN"]},
    "status": {"enum": ["NOT_ATTEMPTED", "INTENT_RECORDED", "EFFECT_UNKNOWN_RECONCILE", "EFFECT_VERIFIED", "FAILED_VERIFIED", "REVIEW_REQUIRED"]},
    "reconciliation_plan": {"type": "string", "minLength": 1},
    "result_ref": {"type": ["string", "null"]},
    "observed_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
